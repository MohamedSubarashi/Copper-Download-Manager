{
  "manifest_version": 3,
  "name": "Copper Download Manager",
  "version": "1.0.2",
  "description": "Intercept downloads and send them to Copper Download Manager",
  "permissions": ["downloads", "notifications", "storage"],
  "host_permissions": ["http://localhost:24680/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  }
}
