{
  "manifest_version": 3,
  "name": "Copper Download Manager",
  "version": "4.0.0",
  "description": "Powerful download interceptor and launcher for Copper Download Manager.",
  "permissions": [
    "contextMenus",
    "storage",
    "tabs",
    "notifications",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Copper Download Manager",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  }
}
