{
  "manifest_version": 3,
  "name": "Copper Download Manager",
  "version": "2.0.0",
  "description": "Powerful download interceptor — send downloads, detect media, bulk download, and more with Copper Download Manager",
  "permissions": ["downloads", "notifications", "storage", "contextMenus", "activeTab", "scripting", "tabs"],
  "host_permissions": ["http://localhost:*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  }
}
