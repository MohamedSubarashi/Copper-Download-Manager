{
  "manifest_version": 3,
  "name": "Copper Download Manager",
  "version": "5.3.0",
  "description": "Powerful download interceptor and launcher for Copper Download Manager.",
  "permissions": [
    "contextMenus",
    "storage",
    "tabs",
    "notifications",
    "nativeMessaging",
    "downloads"
  ],
  "host_permissions": [
    "http://127.0.0.1:24680/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "copper-bar.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Copper Download Manager",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "copper-download-manager@copper",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  }
}