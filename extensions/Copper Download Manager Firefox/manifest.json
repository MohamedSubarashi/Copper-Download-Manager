{
  "manifest_version": 2,
  "name": "Copper Download Manager",
  "version": "2.0.0",
  "description": "Powerful download interceptor — send downloads, detect media, bulk download, and more with Copper Download Manager",
  "permissions": ["downloads", "storage", "notifications", "contextMenus", "activeTab", "tabs", "http://localhost:*/*"],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": ["icons/*.png"],
  "browser_specific_settings": {
    "gecko": {
      "id": "copper-download-manager@copper",
      "strict_min_version": "59.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  }
}
