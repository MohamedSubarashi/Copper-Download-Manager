# Intermediate build output
build/
build-debug/
build-*/

# Debug build output (deployed by the CMake post-build hook)
debug/

# CMake artifacts
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake
.vscode/
.idea/

# opencode local config
.opencode/

# Scratch / repro files
crash_repro.cpp
repr/

# Deployed release runtime (generated by the CMake windeployqt post-build hook)
installer/release/

# Local release packaging output (Setup.exe, zip, deployed binaries)
Release/

# Duplicated release runtime folders (binaries are built by CI and shipped as
# release assets, never committed to the repo). 1.0.0 ships a single setup exe
# on GitHub; the tracked releases/ tree is gone.
releases/

# Installer intermediate / logs
*.log
*.zip
*.exe

# Python bytecode caches
__pycache__/

# Editor/agent scratch state
.kilo/

# Duplicated working copies of the repo (backup clones with their own .git)
CopperBuild/
copperdm/

# Scratch build transcript
build-out.txt

# Local user screenshots (kept untracked on disk)
Image/

# Extension store listing images (uploaded manually to store dashboards)
extensions/*.png
